---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, tagUrl, postUrl, readingMinutes } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { id: post.id }, props: { post, newer: posts[index - 1], older: posts[index + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const outline = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<Base title={post.data.title} description={post.data.description} article>
  <article class="article">
    <header class="article-head">
      <a class="back-link" href="/">← 全部文章</a>
      <div class="article-meta">
        <span>发布于 <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
        {post.data.updated && <span>更新于 <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></span>}
        <span>约 {readingMinutes(post.body)} 分钟阅读</span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="dek">{post.data.description}</p>}
      <div class="post-tags">{post.data.tags.map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div>
    </header>
    {outline.length > 2 && <details class="toc"><summary>文章目录</summary><nav aria-label="文章目录"><ul>{outline.map(heading => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav></details>}
    <div class="prose"><Content /></div>
    <div class="reading-end"><a href="#main">↑ 返回文章顶部</a><a href="/rss.xml">通过 RSS 订阅</a></div>
    <nav class="article-pagination" aria-label="相邻文章">
      {older && <a href={postUrl(older.id)}><span>← 更早一篇</span>{older.data.title}</a>}
      {newer && <a href={postUrl(newer.id)}><span>更新一篇 →</span>{newer.data.title}</a>}
    </nav>
  </article>
</Base>
